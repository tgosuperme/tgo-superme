# SuperMe · 5-Day Pain Reset, environment
#
# TEMPLATE ONLY. Every value here is blank on purpose: this file is committed,
# so a real key pasted into it ends up in the repo history. Copy it to
# .env.local for local work, and set the same keys in the host's environment
# settings (Vercel: Settings, Environment Variables) for deployments.
#
# Only the NEXT_PUBLIC_ values reach the browser. Everything else is server-side
# and must stay that way.

# ── THE CHALLENGE IS FREE ───────────────────────────────────────────────────
# There is no payment processor and no price. STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET and NEXT_PUBLIC_OFFER_PRICE_GBP are GONE — if any of
# them are still set in the host's environment settings, delete them there too.
# Nothing reads them, but a stale live secret key sitting in a project's env is
# a liability with no upside.

# Absolute origin for the site. Optional: leave unset and the request host is
# used, which is correct on Vercel previews. It no longer has a load-bearing
# job now that Stripe's absolute success and cancel URLs are gone.
NEXT_PUBLIC_SITE_URL=

# ── Pabbly Connect (registrations sheet) ────────────────────────────────────
# The workflow's incoming-webhook URL. /api/register POSTs one flat JSON
# payload per registration to it, and Pabbly appends the row to the sheet.
# Treat it as a secret: anyone holding it can write rows into the sheet.
#
# THE PAYLOAD KEYS ARE UNCHANGED from the paid build, stripe_session_id
# included — see lib/pabbly.ts for why. So an existing workflow keeps working
# as-is, and its dedupe step should keep looking rows up by stripe_session_id,
# which now carries the registration id.
PABBLY_WEBHOOK_URL=

# ── Meta Pixel + Conversions API ────────────────────────────────────────────
# The pixel id appears twice ON PURPOSE. The NEXT_PUBLIC_ one is inlined into
# the browser bundle to boot the Pixel (a pixel id is public by definition, it
# ships in the page source of every site that uses one). The server-side one is
# read by /api/track and /api/register when they post events to the
# Conversions API. Same value, two different places, so neither reaches for the
# other's copy.
# e.g. 1234567890123456 (15 to 16 digits)
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=

# System-user access token with ads_management, from Events Manager ▸ Settings
# ▸ Conversions API ▸ Generate access token. SERVER ONLY. Anyone holding this
# can write events into your ad account, so it must never be NEXT_PUBLIC_.
# e.g. EAAG...ZDZD (a long string, roughly 200 characters)
META_CAPI_ACCESS_TOKEN=

# Set ONLY while testing, from Events Manager ▸ Test Events. Events sent with a
# test code appear in that tab and are excluded from optimisation, so leaving
# this set in production means Meta never learns from a single real
# registration.
META_TEST_EVENT_CODE=

# Graph API version, defaults to v21.0. Only set this to move deliberately.
META_GRAPH_VERSION=

# ── Google Analytics 4 ──────────────────────────────────────────────────────
# Optional. Defaults to the live property id in components/GoogleAnalytics.tsx,
# so leaving this blank is fine. Set it only to point a deployment at a
# different property. A GA measurement id is public: it ships in the page
# source of every site that uses one, which is why it is not a secret.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Microsoft Clarity (session replay) ──────────────────────────────────────
# Optional. Defaults to the live project id in components/Clarity.tsx, so
# leaving this blank is fine. Public, like the GA and Pixel ids.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ── Offer (drives every date and time on the page) ──────────────────────────
# Falls back to 18th August / 7 AM & 7 PM in lib/offer-config.ts when unset, so
# the page never renders a blank date. Written the way they should READ on the
# page, not as machine dates.
#
# There is NO price variable any more. The word the page shows where a price
# used to be, and the reassurance line under every CTA, are both fixed strings
# in lib/offer-config.ts (priceLabel, ctaNote) rather than env values — they
# are copy, and copy that changes belongs in a commit.
NEXT_PUBLIC_START_DATE=
NEXT_PUBLIC_SESSION_TIMES=

# The "twice a day" label above the session times, and the zone appended where
# a time needs one (the thank-you page's diary card, mainly). Default to
# "Live Sessions, Twice A Day" and "UK time"; set the zone blank to drop it.
NEXT_PUBLIC_SESSIONS_LABEL=
NEXT_PUBLIC_SESSION_TIMEZONE=

# ── Thank-you page ──────────────────────────────────────────────────────────
# The WhatsApp community invite. Fills ALL THREE "Join the Community" buttons
# on /thank-you: the green card, the navy band, and the docked mobile bar. If
# left unset they still render, flat and non-clickable, so a missing value is
# obvious rather than silently broken.
#
# Format: https://chat.whatsapp.com/<invite-code>
#
# Left BLANK rather than given a dummy value, and for a stronger reason than
# the usual one. A fake URL here would make the buttons clickable and dead,
# which looks fine in review and fails only for a buyer who has already paid.
# Empty makes them render flat and non-clickable, so a missing invite is
# obvious the moment anyone opens the page.
#
# It is also a live invite: anyone reading the repo could use it to join the
# group. Real value goes in .env.local and in the host's env settings, never
# in this file.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=

# ── Contact ─────────────────────────────────────────────────────────────────
# The one address the privacy, terms and cancellations pages route every
# question to.
# Format: name@domain
#
# Falls back to hello@superme.co.uk when unset, so the pages never render a
# broken mailto:. That fallback is a PLACEHOLDER, not a monitored inbox, and UK
# rules expect these pages to give a contact route that actually works. Set it
# before running traffic.
NEXT_PUBLIC_CONTACT_EMAIL=
