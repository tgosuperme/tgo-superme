# SuperMe · 5-Day Pain Reset, environment
#
# TEMPLATE ONLY. Every value here is blank on purpose: this file is committed,
# so a real key pasted into it ends up in the repo history. Copy it to
# .env.local for local work, and set the same keys in the host's environment
# settings (Vercel: Settings, Environment Variables) for deployments.
#
# Only the NEXT_PUBLIC_ values reach the browser. Everything else is server-side
# and must stay that way.

# ── Stripe (UK account, GBP) ────────────────────────────────────────────────
# Secret key: sk_test_ / sk_live_, or rk_ for a restricted key, which needs
# write on Checkout Sessions and PaymentIntents.
STRIPE_SECRET_KEY=

# Signing secret for the webhook, from `stripe listen` locally or from the
# dashboard endpoint. Live and test endpoints have DIFFERENT secrets, and a
# live key paired with a test secret fails every signature check.
STRIPE_WEBHOOK_SECRET=

# Absolute origin used for Stripe's success and cancel URLs. Leave unset and
# the request host is used, which is correct on Vercel previews. Set it when
# the live site sits behind a proxy or a custom domain.
NEXT_PUBLIC_SITE_URL=

# ── Pabbly Connect (sales sheet) ────────────────────────────────────────────
# The workflow's incoming-webhook URL. The Stripe webhook POSTs one flat JSON
# payload per paid seat to it, and Pabbly appends the row to the sheet. Treat
# it as a secret: anyone holding it can write rows into the sales sheet.
# Dedupe in the Pabbly workflow on stripe_session_id: Stripe retries failed
# events, so the same sale can legitimately arrive more than once.
PABBLY_WEBHOOK_URL=

# ── Pabbly · the LEAD sheet ─────────────────────────────────────────────────
# A SEPARATE workflow from PABBLY_WEBHOOK_URL above. Hit the moment the details
# form is submitted and the Stripe session opens, BEFORE payment — so the row
# exists whether or not the buyer ever pays. A lead with no matching sale row
# is exactly the person who abandoned.
# lead_id is the Stripe session id, the same value the sale row carries, so the
# two sheets join on it. Blank = the form still works and abandoned_cart still
# fires to Meta, but no row is written.
PABBLY_LEAD_WEBHOOK_URL=

# ── Pabbly · the REGISTRATION sheet ─────────────────────────────────────────
# The THIRD workflow, and the busiest of them by a wide margin. Hit the moment
# the landing page's modal form is submitted — which, now that the seat is
# free, is the funnel's main conversion rather than a step towards one.
#
# How the three differ, because three Pabbly URLs in one file needs saying:
#
#   THIS ONE        every registration. Everybody who fills the form.
#   ..._LEAD_...    only people who opened the VIP checkout and did not pay.
#   PABBLY_WEBHOOK  only people who paid for VIP.
#
# A VIP buyer therefore appears in this sheet AND the sale sheet — they
# registered, then upgraded. Join them on email to read the real free-to-VIP
# conversion rate instead of estimating it. Someone in this sheet and the lead
# sheet but not the sale sheet wanted the pass and did not finish.
#
# Dedupe this workflow on lead_id: a double-tapped submit button is the normal
# way the same registration arrives twice.
#
# Blank = the form still works, the cookie is still issued and
# registration_complete still reaches Meta, but no row is written.
PABBLY_FREE_WEBHOOK_URL=

# ── Free registration token ─────────────────────────────────────────────────
# Signs the cookie that lets /confirmed show the joining instructions to
# somebody who registered but never paid. There is nothing to fetch from a
# dashboard here: it is any long random string you invent once
# (`openssl rand -hex 32`).
#
# It exists BECAUSE the free route is different. A VIP buyer's /confirmed-plus
# can ask Stripe whether a session was paid; a free registrant has no payment
# to check, so without a signed cookie /confirmed is a public URL and the
# WhatsApp invite leaks to anyone who guesses it or gets it forwarded.
#
# If unset it falls back to STRIPE_SECRET_KEY, which works — the only cost is
# that rotating the Stripe key invalidates registrations issued before the
# rotation. Tokens last 12 hours, so that window is small.
REGISTRATION_SECRET=

# ── Meta Pixel + Conversions API ────────────────────────────────────────────
# The pixel id appears twice ON PURPOSE. The NEXT_PUBLIC_ one is inlined into
# the browser bundle to boot the Pixel (a pixel id is public by definition, it
# ships in the page source of every site that uses one). The server-side one is
# read by the webhook when it posts the Purchase to the Conversions API. Same
# value, two different places, so neither reaches for the other's copy.
# e.g. 1234567890123456 (15 to 16 digits)
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=

# System-user access token with ads_management, from Events Manager ▸ Settings
# ▸ Conversions API ▸ Generate access token. SERVER ONLY. Anyone holding this
# can write events into your ad account, so it must never be NEXT_PUBLIC_.
# e.g. EAAG...ZDZD (a long string, roughly 200 characters)
META_CAPI_ACCESS_TOKEN=

# Set ONLY while testing, from Events Manager ▸ Test Events. Events sent with a
# test code appear in that tab and are excluded from optimisation, so leaving
# this set in production means Meta never learns from a single real purchase.
META_TEST_EVENT_CODE=

# Graph API version, defaults to v21.0. Only set this to move deliberately.
META_GRAPH_VERSION=

# ── Google Analytics 4 ──────────────────────────────────────────────────────
# Optional. Defaults to the live property id in components/GoogleAnalytics.tsx,
# so leaving this blank is fine. Set it only to point a deployment at a
# different property. A GA measurement id is public: it ships in the page
# source of every site that uses one, which is why it is not a secret.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Microsoft Clarity (session replay) ──────────────────────────────────────
# Optional. Defaults to the live project id in components/Clarity.tsx, so
# leaving this blank is fine. Public, like the GA and Pixel ids.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ── Offer (drives every price and date on the page) ─────────────────────────
# Falls back to 4.99 / 18th August / 7 AM & 7 PM in lib/checkout-config.ts when
# unset, so the page never renders a blank price. Written the way they should
# READ on the page, not as machine dates.
#
# Prices take DECIMALS: 1.99 is read as £1.99 and charged as 199p. Write them
# as bare numbers — no currency symbol, no thousands separator.
#
# THE SEAT IS FREE. There is no NEXT_PUBLIC_OFFER_PRICE_AED any more: a place
# on the challenge costs nothing, is registered by the modal form on the
# landing page and never reaches Stripe. So there is exactly one price in the
# funnel, below, and exactly one checkout.
#
# 4.99 IS A CHANGE FROM THE 19.99 THIS BRANCH CARRIED. 19.99 was the VIP price
# when the seat itself cost 4.99 and the pass was the dearer of two things to
# choose between. The brief for the free funnel named 4.99 for the pass. If the
# intended price really is 19.99, set it here — nothing in the code assumes
# either figure.
NEXT_PUBLIC_VIP_PRICE_AED=4.99

# ONE HALF OF THE STRUCK 40. The five live days are valued at 20 and the four
# guides at 5 each, so this and bonus-data.ts sum to the figure the landing
# page and the checkout both strike through. Move one and look at the other.
#
# It is a REAL comparison — five live group sessions at the app's own
# per-session rate — and the page says so directly underneath. Never set this
# to a former price of this offer.
NEXT_PUBLIC_ANCHOR_PRICE_AED=20

# The cohort. START and END drive every date on the site, including the
# "30th September to 4th October" range on the confirmation pages.
NEXT_PUBLIC_START_DATE=
NEXT_PUBLIC_END_DATE=
NEXT_PUBLIC_REGISTRATIONS_CLOSE=
NEXT_PUBLIC_SESSION_TIMES=

# The "twice a day" label above the session times, and the zone appended where
# a time needs one. Default to "Live Sessions, Twice A Day" and "GST"; set the
# zone blank to drop it.
NEXT_PUBLIC_SESSIONS_LABEL=
NEXT_PUBLIC_SESSION_TIMEZONE=

# ── Confirmation preview ────────────────────────────────────────────────────
# Set to 1 to let /confirmed?preview=1 and /confirmed-plus?preview=1 render the
# confirmed state with no real payment, so the pages can be reviewed.
#
# LEAVE THIS BLANK IN PRODUCTION. While it is 1, anyone who guesses the query
# string sees the full joining instructions with no proof of purchase, and
# noindex is a crawler hint rather than access control.
NEXT_PUBLIC_PREVIEW_CONFIRMATION=

# ── Thank-you page ──────────────────────────────────────────────────────────
# The WhatsApp community invite. Fills ALL THREE "Join the Community" buttons
# on /thank-you: the green card, the navy band, and the docked mobile bar. If
# left unset they still render, flat and non-clickable, so a missing value is
# obvious rather than silently broken.
#
# Format: https://chat.whatsapp.com/<invite-code>
#
# Left BLANK rather than given a dummy value, and for a stronger reason than
# the usual one. A fake URL here would make the buttons clickable and dead,
# which looks fine in review and fails only for a buyer who has already paid.
# Empty makes them render flat and non-clickable, so a missing invite is
# obvious the moment anyone opens the page.
#
# It is also a live invite: anyone reading the repo could use it to join the
# group. Real value goes in .env.local and in the host's env settings, never
# in this file.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=

# ── Contact ─────────────────────────────────────────────────────────────────
# The one address the privacy, terms and refund pages route every question to.
# Format: name@domain
#
# Falls back to hello@superme.co.uk when unset, so the pages never render a
# broken mailto:. That fallback is a PLACEHOLDER, not a monitored inbox, and UK
# rules expect these pages to give a contact route that actually works. Set it
# before running traffic.
NEXT_PUBLIC_CONTACT_EMAIL=
