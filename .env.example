# SuperMe India · 5-Day Pain Reset — environment
#
# TEMPLATE ONLY. Copy to .env.local for local work; set the same keys in
# Vercel → Settings → Environment Variables for deployments.
# NEXT_PUBLIC_* reach the browser. Everything else stays server-side.


# ── Razorpay ────────────────────────────────────────────────────────────────
# Two hosted Payment Pages, one per pass. /go redirects to the matching one.
# BOTH PAGES NEED ref_id AND ref_id2 AS CUSTOM FIELDS, or all UTM/attribution
# columns arrive empty.
#
# Set each page's SUCCESS REDIRECT in the Razorpay dashboard:
#   Standard  →  https://india.mysuperme.com/confirmed
#   VIP       →  https://india.mysuperme.com/confirmed-plus
# USE THE LONG pages.razorpay.com FORM, NOT the rzp.io shortlink the
# dashboard's Copy-link button gives you. The shortlink 302s and DROPS THE
# QUERY STRING, so ref_id never reaches the page and every sale is dropped by
# the webhook's ownership gate. (/go resolves a shortlink at runtime as a
# safety net, but that costs a redirect on every click — paste the long one.)
NEXT_PUBLIC_RAZORPAY_PAGE_BASE=https://pages.razorpay.com/pl_TS7plD5cahZ5oX/view
NEXT_PUBLIC_RAZORPAY_PAGE_VIP=https://pages.razorpay.com/pl_TYfKqz5Jy0ZVbB/view

# Webhook, from Razorpay → Settings → Webhooks.
# URL:    https://india.mysuperme.com/api/webhooks/razorpay
# Event:  payment.captured        (this one only — see the route file)
RAZORPAY_WEBHOOK_SECRET=


# ── Prices ──────────────────────────────────────────────────────────────────
# Bare numbers, no ₹ and no commas. Change one and the whole site follows:
# every CTA, the struck-through price, the savings figure and the % badge.
#
# VIP is a TOTAL, not an add-on — it includes the Standard Pass. Nothing
# anywhere adds the two together.
NEXT_PUBLIC_OFFER_PRICE_INR=497
NEXT_PUBLIC_VIP_PRICE=999

# Struck-through "regular" prices are auto-calculated as price × multiplier,
# rounded to the nearest x99 (497 → ₹2,499 · 999 → ₹4,999). The multiple is
# five live group sessions at the app's own per-session rate, which is what
# makes the anchor a real price rather than an invented one.
NEXT_PUBLIC_ANCHOR_MULTIPLIER=5
# Optional hard overrides. Blank = use the multiplier.
NEXT_PUBLIC_ANCHOR_PRICE=
NEXT_PUBLIC_VIP_ANCHOR_PRICE=

# The price rise, computed from the clock — nothing to touch on the night.
# The *_UNTIL value MUST carry +05:30 or it fires 5½ hours late.
# A risen price needs its own Razorpay page; unset, buyers pay the old price.
NEXT_PUBLIC_PRICE_STEP_1_UNTIL=2026-09-21T23:59:59+05:30
NEXT_PUBLIC_PRICE_STEP_2=997
NEXT_PUBLIC_RAZORPAY_PAGE_BASE_STEP_2=

# After this, every CTA becomes the waiting list.
NEXT_PUBLIC_REGISTRATIONS_CLOSE=2026-09-22T23:59:59+05:30
NEXT_PUBLIC_WAITING_LIST_URL=


# ── Dates and times (printed, never parsed) ─────────────────────────────────
NEXT_PUBLIC_START_DATE=23rd September
NEXT_PUBLIC_END_DATE=27th September
NEXT_PUBLIC_DATE_RANGE=23rd to 27th September
NEXT_PUBLIC_SESSION_TIME_1=7 AM
NEXT_PUBLIC_SESSION_TIME_2=7 PM
NEXT_PUBLIC_SESSION_TIMEZONE=IST
NEXT_PUBLIC_SESSIONS_LABEL=Live Sessions, Twice A Day


# ── CRM ─────────────────────────────────────────────────────────────────────
# ONE webhook for both passes. The row's `product` field ("base" | "vip") is
# what tells them apart — filter on it in Pabbly.
# Dedupe the workflow on razorpay_payment_id: Razorpay retries failed events.
PABBLY_WEBHOOK_URL=

# Optional. Records the one-tap session-timing answer from /confirmed.
# Falls back to PABBLY_WEBHOOK_URL. Payload carries
# record_type=timing_preference, and can arrive BEFORE the payment webhook.
PABBLY_TIMING_WEBHOOK_URL=


# ── Contact and community ───────────────────────────────────────────────────
# SET BOTH BEFORE RUNNING TRAFFIC.
# Without the WhatsApp link the "Join the Community" buttons on /confirmed
# render flat and non-clickable. The contact fallback is a UK address.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=
NEXT_PUBLIC_CONTACT_EMAIL=


# ── Analytics ───────────────────────────────────────────────────────────────
# GA4 and Clarity ids are hard-coded in components/GoogleAnalytics.tsx and
# components/Clarity.tsx — nothing to set here.
#
# Meta events are NOT fired from this site; they fire from the Razorpay side.
# The keys below are read only if present and can stay blank.
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Canonical/og: URLs use https://india.mysuperme.com from lib/site.ts.
# Set this only behind a proxy that rewrites the host.
NEXT_PUBLIC_SITE_URL=


# ── Day 5 seat hold · /hold, /call, /balance ────────────────────────────────
# Sold on Day 5, never linked from the landing page.
# The hold must stay REFUNDABLE and CREDITED — the pages say so.
NEXT_PUBLIC_HOLD_PRICE=999
NEXT_PUBLIC_RAZORPAY_PAGE_HOLD=

# Seat counter on /hold — a real number, updated by hand. Set SEATS_LEFT=0 to
# hide the line rather than let it go stale.
NEXT_PUBLIC_HOLD_SEATS_TOTAL=20
NEXT_PUBLIC_HOLD_SEATS_LEFT=20

# The two programme options. "website" is the app price, "challenge" is what a
# participant pays.
NEXT_PUBLIC_P30_WEBSITE=17499
NEXT_PUBLIC_P30_CHALLENGE=12999
NEXT_PUBLIC_P60_WEBSITE=32999
NEXT_PUBLIC_P60_CHALLENGE=21999
NEXT_PUBLIC_PROGRAMME_BONUS_VALUE=9999

# Booking embed for /call. Unset, the page falls back to "we'll WhatsApp you".
NEXT_PUBLIC_BOOKING_URL=

# /balance links to one of these via ?plan=30 or ?plan=60.
NEXT_PUBLIC_RAZORPAY_PAGE_BALANCE_30=
NEXT_PUBLIC_RAZORPAY_PAGE_BALANCE_60=
NEXT_PUBLIC_BATCH_START_DATE=28th September
