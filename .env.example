# SuperMe free pain assessment call funnel (branch ht-call)
# Copy to .env.local and fill. Every variable below is read somewhere in the code,
# and every process.env read in the code is declared here.

# ── SITE ────────────────────────────────────────────────────────────────────
# The host that actually serves this funnel, apex form, no trailing slash.
# Check it first: curl -sS -o /dev/null -D - https://<host> | grep -iE '^HTTP/|^location:'
# A 308 means that host is not canonical; use the one that returns 200.
# Without it: canonical urls, og tags and every Meta event_source_url point at localhost.
NEXT_PUBLIC_SITE_URL=

# The one inbox shown in the footer, the legal pages, the booking fallback and the thank-you.
# Without it the site falls back to hello@superme.co.uk.
NEXT_PUBLIC_CONTACT_EMAIL=

# Booking needs no env value: the Calendly event url lives in lib/call.ts.

# ── PABBLY ──────────────────────────────────────────────────────────────────
# Pabbly Connect → the workflow → the Webhook trigger's URL. Receives every
# pre-booking form (name, email, WhatsApp, UTMs, fbc/fbp). Server-side only.
# Without it the form still works and still sends Meta a Lead; nothing reaches Pabbly.
PABBLY_WEBHOOK_URL=

# ── META ────────────────────────────────────────────────────────────────────
# Pixel id, Events Manager → Data sources → the dataset → Settings.
# The browser copy only fires PageView and sets the _fbp cookie. Without it: no PageView, weaker matching.
NEXT_PUBLIC_META_PIXEL_ID=
# Same pixel id, read server-side by the Conversions API route.
META_PIXEL_ID=
# Events Manager → the dataset → Settings → Conversions API → Generate access token.
# Without either of these two: ViewContent and Schedule are never sent.
META_CAPI_ACCESS_TOKEN=
# Events Manager → Test events. For testing only.
# ⚠️ REMOVE BEFORE LAUNCH. Events sent with a test code do not count toward optimisation.
META_CAPI_TEST_EVENT_CODE=

# ── GA4 ─────────────────────────────────────────────────────────────────────
# Admin → Data streams → the web stream → Measurement ID (G-XXXXXXX).
# Without it no GA4 tag renders and view_item / generate_lead go nowhere.
NEXT_PUBLIC_GA4_ID=

# ── CLARITY ─────────────────────────────────────────────────────────────────
# clarity.microsoft.com → the project → Settings → Overview → Project ID.
NEXT_PUBLIC_CLARITY_ID=

# ── NOT ENV, but required before launch ─────────────────────────────────────
# · Real client photos/results for THE PROOF section, and the video testimonials.
# · Privacy, terms and refund pages still describe the paid 5-Day challenge (red [TODO] banner on each).
# · Calendly: the event is "10min" but the page promises a 30-minute call; align one or the other.
#   Leave the event's "After booking" on Calendly's own confirmation page: a redirect set
#   there skips the page's handler, so Schedule never fires.
# · Calendly webhook (invitee.created) → Pabbly, if bookings should land in the CRM sheet.
