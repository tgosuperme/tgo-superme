# SuperMe · 5-Day Pain Reset, environment
#
# TEMPLATE ONLY — AND NEXT.JS NEVER READS THIS FILE.
#
# Two things follow from that, and both have caught people out on this repo:
#
#   1. A key pasted here DOES NOTHING. The app loads .env.local (and .env,
#      .env.development, .env.production) — never .env.example. If a value here
#      seems to be ignored, that is why.
#   2. A key pasted here IS COMMITTED. This file is tracked, so a real secret
#      typed into it goes into the repo history and has to be rotated, not just
#      deleted.
#
# Put real values in .env.local for local work — it is gitignored — and in the
# host's environment settings (Vercel: Settings ▸ Environment Variables) for
# deployments.
#
# Only the NEXT_PUBLIC_ values reach the browser. Everything else is server-side
# and must stay that way.

# ── THE CHALLENGE IS FREE; THE VIP UPGRADE IS NOT ───────────────────────────
# Registering costs nothing and touches no payment processor. Stripe is reached
# exactly once, when someone chooses VIP on /upgrade after they have already
# registered. So the Stripe keys below are needed for the UPGRADE only — if
# they are missing, registration still works perfectly and the VIP button
# returns a clean "not available right now".

# ── Stripe (UK account, GBP) · VIP upgrade only ─────────────────────────────
# Secret key: sk_test_ / sk_live_, or rk_ for a restricted key, which needs
# write on Checkout Sessions and PaymentIntents.
STRIPE_SECRET_KEY=

# Signing secret for the webhook, from `stripe listen` locally or from the
# dashboard endpoint. Live and test endpoints have DIFFERENT secrets, and a
# live key paired with a test secret fails every signature check.
#
# Point the endpoint at POST /api/webhooks/stripe and subscribe it to
# checkout.session.completed, checkout.session.async_payment_succeeded and
# charge.refunded.
STRIPE_WEBHOOK_SECRET=

# Absolute origin, used for Stripe's success and cancel URLs. Leave unset and
# the request host is used, which is correct on Vercel previews. Set it when
# the live site sits behind a proxy or a custom domain.
NEXT_PUBLIC_SITE_URL=

# ── Pabbly Connect · TWO webhooks, two sheets ───────────────────────────────
# Both receive the SAME flat payload shape, and both carry the full attribution
# set (utm_*, fbclid, gclid, referrer, landing_url, fbc, fbp, IP, user agent) —
# so the VIP sheet can answer "which ad produced this sale?" on its own.
#
# Treat both as secrets: anyone holding one can write rows into that sheet.

# EVERY registration, POSTed by /api/register the moment the form is submitted.
# tier is "free" on every row here, including rows for people who go on to buy
# VIP a minute later — this sheet counts registrations, not outcomes.
# Dedupe the workflow on lead_id.
PABBLY_WEBHOOK_URL=

# VIP UPGRADES ONLY, POSTed by the Stripe webhook once the money has cleared.
# tier is "vip". lead_id is the SAME value as on that person's registration
# row, so the two sheets join on it.
# Dedupe this workflow on stripe_session_id — Stripe retries failed webhooks
# for up to three days and each retry re-runs the handler.
PABBLY_VIP_WEBHOOK_URL=

# ── Meta Pixel + Conversions API ────────────────────────────────────────────
# The pixel id appears twice ON PURPOSE. The NEXT_PUBLIC_ one is inlined into
# the browser bundle to boot the Pixel (a pixel id is public by definition, it
# ships in the page source of every site that uses one). The server-side one is
# read by /api/track and /api/register when they post events to the
# Conversions API. Same value, two different places, so neither reaches for the
# other's copy.
# e.g. 1234567890123456 (15 to 16 digits)
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=

# System-user access token with ads_management, from Events Manager ▸ Settings
# ▸ Conversions API ▸ Generate access token. SERVER ONLY. Anyone holding this
# can write events into your ad account, so it must never be NEXT_PUBLIC_.
# e.g. EAAG...ZDZD (a long string, roughly 200 characters)
META_CAPI_ACCESS_TOKEN=

# Set ONLY while testing, from Events Manager ▸ Test Events. Events sent with a
# test code appear in that tab and are excluded from optimisation, so leaving
# this set in production means Meta never learns from a single real
# registration.
META_TEST_EVENT_CODE=

# Graph API version, defaults to v21.0. Only set this to move deliberately.
META_GRAPH_VERSION=

# ── Google Analytics 4 ──────────────────────────────────────────────────────
# Optional. Defaults to the live property id in components/GoogleAnalytics.tsx,
# so leaving this blank is fine. Set it only to point a deployment at a
# different property. A GA measurement id is public: it ships in the page
# source of every site that uses one, which is why it is not a secret.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Microsoft Clarity (session replay) ──────────────────────────────────────
# Optional. Defaults to the live project id in components/Clarity.tsx, so
# leaving this blank is fine. Public, like the GA and Pixel ids.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ── Offer (drives every date and time on the page) ──────────────────────────
# Falls back to 18th August / 7 AM & 7 PM in lib/offer-config.ts when unset, so
# the page never renders a blank date. Written the way they should READ on the
# page, not as machine dates.
#
# The word the free tier shows where a price would sit, and the reassurance
# line under every CTA, are fixed strings in lib/offer-config.ts (priceLabel,
# ctaNote) rather than env values — they are copy, and copy belongs in a commit.
NEXT_PUBLIC_START_DATE=
NEXT_PUBLIC_SESSION_TIMES=

# The VIP upgrade price, and the ONLY price in the funnel. Defaults to 4.99.
#
# Takes DECIMALS: 4.99 is read as £4.99 and charged as 499p. Write it as a bare
# number — no currency symbol, no thousands separator. It is parsed with
# parseFloat and rounded to two places; an earlier build used parseInt here and
# silently charged £4 for a £4.99 offer, which is why lib/offer-config.ts
# carries a comment about it.
NEXT_PUBLIC_VIP_PRICE_GBP=4.99

# The "twice a day" label above the session times, and the zone appended where
# a time needs one (the thank-you page's diary card, mainly). Default to
# "Live Sessions, Twice A Day" and "UK time"; set the zone blank to drop it.
NEXT_PUBLIC_SESSIONS_LABEL=
NEXT_PUBLIC_SESSION_TIMEZONE=

# ── Thank-you page ──────────────────────────────────────────────────────────
# The WhatsApp community invite. Fills ALL THREE "Join the Community" buttons
# on /thank-you: the green card, the navy band, and the docked mobile bar. If
# left unset they still render, flat and non-clickable, so a missing value is
# obvious rather than silently broken.
#
# Format: https://chat.whatsapp.com/<invite-code>
#
# Left BLANK rather than given a dummy value, and for a stronger reason than
# the usual one. A fake URL here would make the buttons clickable and dead,
# which looks fine in review and fails only for a buyer who has already paid.
# Empty makes them render flat and non-clickable, so a missing invite is
# obvious the moment anyone opens the page.
#
# It is also a live invite: anyone reading the repo could use it to join the
# group. Real value goes in .env.local and in the host's env settings, never
# in this file.
NEXT_PUBLIC_WHATSAPP_COMMUNITY_URL=

# ── Contact ─────────────────────────────────────────────────────────────────
# The one address the privacy, terms and cancellations pages route every
# question to.
# Format: name@domain
#
# Falls back to hello@superme.co.uk when unset, so the pages never render a
# broken mailto:. That fallback is a PLACEHOLDER, not a monitored inbox, and UK
# rules expect these pages to give a contact route that actually works. Set it
# before running traffic.
NEXT_PUBLIC_CONTACT_EMAIL=
